---
import Skill from '@components/Skill.astro';

interface Props {
	name: string;
    problem: string;
    description: string;
    tags: Array<string>
}

const { name, problem, description, tags } = Astro.props;
---
<article>
    <h3 class="text-lg">
        {name}
    </h3>

    <p class="font-mono text-xs text-pale-orange/70 mb-2">
        {problem}
    </p>

    <p class="text-base leading-snug! mb-3">
        {description}
    </p>

    <ul class="flex flex-wrap gap-2 list-none p-0">
        {tags.map((name) => (
            <Skill name={name} />
        ))}
    </ul>
</article>
